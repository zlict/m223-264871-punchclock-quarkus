@startuml 03-erd
!pragma layout smetana
hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #EAF1FB
  BorderColor #5B7DB1
}

entity "entry" as entry <<Table>> {
  <&key> **id** : bigint <<PK>> GENERATED BY DEFAULT AS IDENTITY
  --
  checkin : timestamp(6) NOT NULL
  checkout : timestamp(6) NOT NULL
  category_id : bigint <<FK>>
}

entity "category" as category <<Table>> {
  <&key> **id** : bigint <<PK>> GENERATED BY DEFAULT AS IDENTITY
  --
  title : varchar(255) NOT NULL
}

entity "tag" as tag <<Table>> {
  <&key> **id** : bigint <<PK>> GENERATED BY DEFAULT AS IDENTITY
  --
  title : varchar(255) NOT NULL
}

entity "entry_tag" as entry_tag <<Table>> {
  <&key> **entry_id** : bigint <<PK, FK>> NOT NULL
  <&key> **tag_id** : bigint <<PK, FK>> NOT NULL
}

category "c" -- "mc" entry
entry "1" -- "mc" entry_tag
tag "1" -- "mc" entry_tag
@enduml
